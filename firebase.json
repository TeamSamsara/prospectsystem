{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/js/**",
        "headers": [
          { "key": "Content-Type", "value": "text/javascript" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/css/**",
        "headers": [
          { "key": "Content-Type", "value": "text/css" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}